# Stella — copy to .env. Never commit real secrets.

# --- HTTP ---
STELLA_HOST=0.0.0.0
STELLA_PORT=8080
# Public URL Telnyx can reach (webhooks + media WebSocket). Use a tunnel (e.g. cloudflared) locally.
STELLA_PUBLIC_BASE_URL=http://localhost:8080
# Optional: POST JSON job outcomes here when a call ends.
STELLA_CALLBACK_URL=

# --- Telnyx Call Control ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# Ed25519 public key (Mission Control) used to verify webhook signatures.
TELNYX_PUBLIC_KEY=
# Set true only for local tests without Telnyx signatures.
STELLA_SKIP_WEBHOOK_VERIFY=false

# --- Gemini Live (voice provider, REQUIRED) ---
# Calls fail before dialing when this is empty.
GEMINI_API_KEY=
GEMINI_VOICE=Aoede
# Native-audio Live model (BidiGenerateContent). Default gemini-3.8-live
# (https://ai.google.dev/gemini-api/docs/models/gemini-3.8-live).
# Setup-handshake fallbacks (same WS path): gemini-3.1-flash-live-preview,
# gemini-2.5-flash-native-audio-preview-12-2025, gemini-2.5-flash-native-audio-latest.
# Do not use gemini-3.8-live-extended-thinking or the Sep-2025 2.5 preview.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Gemini 2.5: 0 disables thinking tokens. Gemini 3.x: 0 → thinkingLevel=minimal.
# Set -1 to omit thinkingConfig.
GEMINI_THINKING_BUDGET=0
# Client RMS VAD (default on): send activityStart/activityEnd; disables
# automaticActivityDetection. Silence hang 80–150 ms is typical.
STELLA_CLIENT_VAD=true
STELLA_CLIENT_VAD_SILENCE_MS=120
STELLA_CLIENT_VAD_MIN_SPEECH_MS=60
STELLA_CLIENT_VAD_RMS=500
# Server VAD only when STELLA_CLIENT_VAD=false. Barge-in: START_SENSITIVITY_LOW
# is less twitchy. Prefix padding too low clips the first syllable.
GEMINI_VAD_SILENCE_DURATION_MS=300
GEMINI_VAD_PREFIX_PADDING_MS=20
GEMINI_VAD_START_SENSITIVITY=START_SENSITIVITY_HIGH
GEMINI_VAD_END_SENSITIVITY=END_SENSITIVITY_HIGH
GEMINI_VAD_ACTIVITY_HANDLING=START_OF_ACTIVITY_INTERRUPTS
GEMINI_VAD_TURN_COVERAGE=TURN_INCLUDES_ONLY_ACTIVITY
STELLA_LATENCY_LOG=false
STELLA_FAREWELL_HANGUP=true
STELLA_FAREWELL_HANGUP_S=1.5

# --- Frag Ida (Gemini asks Claude Code + Ida MCP during a call) ---
# Off by default. Only offered on calls to STELLA_OWNER_NUMBER, read-only tools only.
ASK_IDA_ENABLED=false
STELLA_OWNER_NUMBER=
ASK_IDA_MODEL=haiku
ASK_IDA_MAX_TURNS=4
ASK_IDA_TIMEOUT_S=25
# Copy ida-mcp.example.json to ./data/ida-mcp.json and fill in your servers.
ASK_IDA_MCP_CONFIG=/data/ida-mcp.json
# Comma-separated exact MCP tool names, READ-ONLY (mcp__<server>__<tool>).
ASK_IDA_ALLOWED_TOOLS=
# Optional: tools usable only after the caller said yes (bestaetigt=true). Keep empty if unsure.
ASK_IDA_WRITE_TOOLS=
# Never allowed (fnmatch patterns). Default blocks SSH, Cloudflare, delete/clear tools.
# ASK_IDA_DENY_TOOLS=
# Claude Code auth: API key (usage-based) OR long-lived token from `claude setup-token`.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Fills ${IDA_MCP_TOKEN} in the MCP config.
IDA_MCP_TOKEN=

# --- Persistence ---
STELLA_DB_PATH=/data/stella.db

# --- MCP HTTP ---
# Optional bearer token Ida must send as Authorization: Bearer ...
STELLA_MCP_TOKEN=
