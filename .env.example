# Stella — copy to .env. Never commit real secrets.

# --- HTTP ---
STELLA_HOST=0.0.0.0
STELLA_PORT=8080
# Public URL Telnyx can reach (webhooks + media WebSocket). Use ngrok/cloudflared locally.
STELLA_PUBLIC_BASE_URL=http://localhost:8080
# Optional: POST JSON job outcomes here when a call ends.
STELLA_CALLBACK_URL=

# --- Telnyx Call Control ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# Ed25519 public key (Mission Control) used to verify webhook signatures.
TELNYX_PUBLIC_KEY=
# Set true only for local tests without Telnyx signatures.
STELLA_SKIP_WEBHOOK_VERIFY=false

# --- xAI / Grok Voice ---
# Preferred for local/dev: billed API key.
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE=eve
# SuperGrok / X Premium+ OAuth tokens are stored under this path (docker volume).
XAI_OAUTH_TOKEN_PATH=/data/xai_oauth.json
# Optional override of the public Grok CLI OAuth client.
XAI_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828

# --- Gemini Live (voice fallback) ---
# Used for the whole call when the one-shot Grok realtime probe fails
# (WS 403, auth, quota/limit, connection errors). Not re-tried mid-call.
GEMINI_API_KEY=
GEMINI_VOICE=Aoede
# Native-audio Live model. Override if Google publishes a faster Live id;
# verify on WS before changing the default.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
# 0 = disable thinking tokens (lowest TTFT on Gemini 2.5). Set -1 to omit.
GEMINI_THINKING_BUDGET=0
# Client RMS VAD (default on): send activityStart/activityEnd; disables
# automaticActivityDetection. Silence hang 80–150 ms is typical.
STELLA_CLIENT_VAD=true
STELLA_CLIENT_VAD_SILENCE_MS=120
STELLA_CLIENT_VAD_MIN_SPEECH_MS=60
STELLA_CLIENT_VAD_RMS=500
# Server VAD only when STELLA_CLIENT_VAD=false. Barge-in: START_SENSITIVITY_LOW
# is less twitchy. Prefix padding too low clips the first syllable.
GEMINI_VAD_SILENCE_DURATION_MS=300
GEMINI_VAD_PREFIX_PADDING_MS=20
GEMINI_VAD_START_SENSITIVITY=START_SENSITIVITY_HIGH
GEMINI_VAD_END_SENSITIVITY=END_SENSITIVITY_HIGH
GEMINI_VAD_ACTIVITY_HANDLING=START_OF_ACTIVITY_INTERRUPTS
GEMINI_VAD_TURN_COVERAGE=TURN_INCLUDES_ONLY_ACTIVITY
STELLA_LATENCY_LOG=false
STELLA_FAREWELL_HANGUP=true
STELLA_FAREWELL_HANGUP_S=1.5

# --- Persistence ---
STELLA_DB_PATH=/data/stella.db

# --- MCP HTTP ---
# Optional bearer token Ida/Grok Bot must send as Authorization: Bearer ...
STELLA_MCP_TOKEN=
