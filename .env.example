# Stella — copy to .env. Never commit real secrets.

# --- HTTP ---
STELLA_HOST=0.0.0.0
STELLA_PORT=8080
# Public URL Telnyx can reach (webhooks + media WebSocket). Use ngrok/cloudflared locally.
STELLA_PUBLIC_BASE_URL=http://localhost:8080
# Optional: POST JSON job outcomes here when a call ends.
STELLA_CALLBACK_URL=

# --- Telnyx Call Control ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# Ed25519 public key (Mission Control) used to verify webhook signatures.
TELNYX_PUBLIC_KEY=
# Set true only for local tests without Telnyx signatures.
STELLA_SKIP_WEBHOOK_VERIFY=false

# --- xAI / Grok Voice ---
# Preferred for local/dev: billed API key.
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE=eve
# SuperGrok / X Premium+ OAuth tokens are stored under this path (docker volume).
XAI_OAUTH_TOKEN_PATH=/data/xai_oauth.json
# Optional override of the public Grok CLI OAuth client.
XAI_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828

# --- Gemini Live (voice fallback) ---
# Used for the whole call when the one-shot Grok realtime probe fails
# (WS 403, auth, quota/limit, connection errors). Not re-tried mid-call.
GEMINI_API_KEY=
# Native-audio Live model. Override if Google retires the preview id.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_VOICE=Aoede

# --- Persistence ---
STELLA_DB_PATH=/data/stella.db

# --- MCP HTTP ---
# Optional bearer token Ida/Grok Bot must send as Authorization: Bearer ...
STELLA_MCP_TOKEN=
